<%# 멤버십 혜택 %>
<section class="relative h-[90vh] min-h-[600px] flex items-center justify-center text-center text-white">
  <img src="https://images.unsplash.com/photo-1587174486073-ae5e5cff23aa?q=80&w=1920&auto=format&fit=crop" alt="골프 이미지" class="absolute inset-0 w-full h-full object-cover -z-10">
  <%# 오버레이 %>
  <div class="absolute inset-0 bg-black/70 -z-10"></div>
  <%# 혜택 텍스트 %>
  <div class="container mx-auto px-4 z-10">
    <span class="text-lg font-bold text-theme-accent-green tracking-widest uppercase mb-2 inline-block">SPECIAL WELCOME OFFER</span>
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black my-6 max-w-5xl mx-auto leading-tight break-keep">
      TGOLSHOP 멤버십, <br/>
      <span class="text-theme-accent-gold">3,000 POINT</span>로 시작하세요.
    </h1>
    <%# 기본 설명 %>
    <p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto text-gray-300 leading-relaxed break-keep">
      지금 회원가입 하시면 즉시 사용 가능한 웰컴 포인트를 드립니다.<br class="hidden md:block"/>
      프리미엄 골프 라이프의 특별한 혜택을 가장 먼저 만나보세요.
    </p>
    <%# 추가 혜택 %>
    <div class="mb-12">
      <div class="inline-block bg-theme-secondary-dark/90 backdrop-blur-sm border border-theme-accent-gold/50 rounded-xl px-8 py-4 shadow-[0_4px_20px_rgba(0,0,0,0.5)] transform transition-transform hover:scale-105 duration-300">
        <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
          <span class="bg-theme-accent-green text-theme-prime-dark text-xs font-black px-2 py-1 rounded uppercase tracking-wider">
            Bonus Tip
          </span>
          <p class="text-base md:text-lg text-white font-medium break-keep">
            추천인 코드 입력 시
            <span class="text-theme-accent-gold font-black text-xl mx-1">+ 1,000P</span>
            추가 적립
          </p>
        </div>
      </div>
    </div>
    <%=link_to "회원가입 하고 혜택 받기", "/", class: "inline-block bg-theme-accent-gold text-theme-prime-dark text-lg font-black py-4 px-12 rounded-full hover:bg-white hover:text-theme-prime-dark transition-all duration-300 transform hover:scale-105 shadow-[0_0_20px_rgba(250,204,21,0.4)]"%>
    <p class="mt-4 text-sm text-gray-400 break-keep">
      * 포인트는 첫 구매 시 즉시 사용 가능합니다.
    </p>
  </div>
</section>